# ===========================================
# Proxy 配置
# Surge 官方手册 - https://manual.nssurge.com/
#
# 使用方式（三选一）：
#   1. 订阅（推荐）：将下方 policy-path 替换为你的订阅地址
#      自动拉取节点，按地区筛选分组
#   2. 手动添加：在下方逐个添加节点
#   3. 混合：订阅 + 手动添加互补
#
# 支持类型：http, https, socks5, socks5-tls, ss, vmess, trojan, snell, wireguard
# 详细文档：https://manual.nssurge.com/proxy/proxy.html
# ===========================================

# ===========================================
# 1. 基础代理
# ===========================================
# 格式：名称 = 类型, 服务器, 端口, 用户名, 密码
# ===========================================
🇨🇳国内直连 = direct
🚫REJECT = reject

# ===========================================
# 2. 示例节点（取消注释后使用）
# ===========================================
# ProxyA = http, 1.2.3.4, 443
# ProxyB = socks5, 5.6.7.8, 1080
# SS_JP = ss, jp.example.com, 443, aes-256-gcm, "your-password"
# VMess_HK = vmess, hk.example.com, 443, "uuid", aes-128-gcm, true, hk.example.com, /api
# Trojan_US = trojan, us.example.com, 443, "your-password"